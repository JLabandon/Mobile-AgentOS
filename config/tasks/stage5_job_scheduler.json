{
  "shop_payment_authorization": {
    "description": "Controlled cross-app operation task used for Stage 5 scheduler validation.",
    "agents": {
      "shop_agent": "shop",
      "payment_agent": "payment"
    },
    "runs": [
      {
        "run_id": "shop_prepare",
        "agent_id": "shop_agent",
        "phase": "prepare",
        "instruction": "Open Mock Shop. Inspect order PX-1042. If the screen shows the order is awaiting payment authorization, complete this preparation phase. Do not open Mock Payment. Do not click COMPLETE AFTER PAYMENT."
      },
      {
        "run_id": "payment_provider",
        "agent_id": "payment_agent",
        "phase": "provider",
        "instruction": "Open Mock Payment. Approve payment for order PX-1042. Complete only when approved status is visible."
      },
      {
        "run_id": "shop_resume",
        "agent_id": "shop_agent",
        "phase": "resume",
        "depends_on": [
          "shop_prepare",
          "payment_provider"
        ],
        "instruction": "Open Mock Shop. Use the structured IPC context from the payment agent. Complete the order and finish only when the order status shows ready for pickup."
      }
    ],
    "ipc": [
      {
        "request_id": "operation_px1042_payment",
        "source_run_id": "payment_provider",
        "target_run_id": "shop_resume",
        "source_agent_id": "payment_agent",
        "target_agent_id": "shop_agent",
        "success_payload": {
          "kind": "RuntimeOperationResponse",
          "operation": "payment_authorization",
          "order_id": "PX-1042",
          "payment_status": "approved"
        },
        "failure_payload": {
          "kind": "RuntimeOperationResponse",
          "operation": "payment_authorization",
          "order_id": "PX-1042",
          "payment_status": "failed"
        },
        "request_summary": "authorize payment for order PX-1042"
      }
    ],
    "success_contains": "ready for pickup",
    "serial_order": [
      "shop_prepare",
      "payment_provider",
      "shop_resume"
    ],
    "clear_packages": [
      "edu.agentos.mockshop",
      "edu.agentos.mockpayment"
    ],
    "final_run_id": "shop_resume"
  }
}
